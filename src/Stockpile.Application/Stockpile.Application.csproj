<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Stockpile.Domain\Stockpile.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      EF Core ABSTRACTIONS only, for DbSet<T> in IAppDbContext. The relational provider
      (Npgsql) and EF's storage/provider namespaces stay forbidden here, and the
      architecture tests in tests/Stockpile.Architecture.Tests enforce that boundary.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Abstractions only: MediatR, FluentValidation and the Microsoft.Extensions
         *.Abstractions packages carry no runtime or provider with them. -->
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
